                        "  columns: ['Enrollment ID', 'Alternate Enrollment ID', 'Initials', 'Sex', 'Race', 'Ethnicity', 'Study Status', 'Diagnosis1', 'Diagnosis2', 'Notes', 'age_now_yrs', 'n_rcc_files', 'n_whole_blood', 'first_sample_date', 'last_sample_date', 'first_run_date', 'last_run_date', 'age_at_first_sample_yrs', 'age_at_last_sample_yrs', 'duplicate_enrollment_id']\n",
