            "source": [
                "# ============================================================================\n",
                "# NanoString RCC -> one master CSV: identity + demographics + raw counts\n",
                "#\n",
                "# Run top to bottom, once. Split on the \"# === CELL n ===\" lines if you want\n",
                "# it as notebook cells.\n",
                "#\n",
                "# Output is a single CSV, one row per RCC file. What used to be separate\n",
                "# tabs are now filter columns: record_type, specimen_type, needs_review,\n",
                "# is_non_blood, qc_pass. Nothing is ever dropped.\n",
                "#\n",
                "# CSV ONLY: no Excel files are written and openpyxl/xlsxwriter are not needed.\n",
                "#\n",
                "# Demographics come from MetadataPatients_NoPHI, joined on Enrollment ID and\n",
                "# Alternate Enrollment ID. Birth date is read only to compute age at the\n",
                "# sample date and is then discarded, so no DOB reaches any output.\n",
                "#\n",
                "# Sample dates: only the date in the RCC ID field counts as the collection\n",
                "# date. run_date (instrument header, then filename) is kept separately.\n",
                "# ============================================================================\n",
                "\n",
                "\n",
                "# === CELL 1 : configuration =================================================\n",
                "import os, re, glob, shutil, hashlib, warnings\n",
                "from datetime import datetime\n",
                "\n",
                "import numpy as np\n",
                "import pandas as pd\n",
                "%pip install -q pyarrow\n",
                "import importlib; importlib.invalidate_caches()\n",
                "\n",
                "# ---- paths -----------------------------------------------------------------\n",
                "FOLDER = \"/home/jovyan/rcc_extracted/Nanostring_RCC\"   # RCC files + metadata\n",
                "OUT    = \"/mnt/filesystems/nanostring_out\"                 # everything is written here\n",
                "\n",
                "# metadata / demographics file; .csv / .xlsx / .xls all work as INPUT.\n",
                "# This is the single source of demographics - there is no separate sheet.\n",
                "# Matching ignores capitalisation and punctuation. The RCC folder, its parent,\n",
                "# and every path in METADATA_SEARCH_DIRS are searched, so the metadata does\n",
                "# NOT have to sit next to the RCC files - it can stay at the mount point.\n",
                "METADATA_GLOB = \"MetadataPatients_NoPHI*\"\n",
                "METADATA_SEARCH_DIRS = [\"/mnt/session_data\", \"/home/jovyan\", \"/mnt\"]\n",
                "\n",
                "# Extra patients to add on top of the main metadata. List full paths to .xlsx /\n",
                "# .csv files whose headers look like the main sheet (Enrollment ID, Sex, ...).\n",
                "# Column names are matched loosely; missing columns are left blank. If the same\n",
                "# enrollment ID is in both, the MAIN sheet wins. Example:\n",
                "#   METADATA_EXTRA = [\"/home/jovyan/rcc_extracted/extra_patients.xlsx\"]\n",
                "METADATA_EXTRA = []\n",
                "\n",
                "# ---- identifiers -----------------------------------------------------------\n",
                "# Birth date is read (age cannot be computed without it) but never written to\n",
                "# any output. Only the derived age survives. Set False only if you specifically\n",
                "# need DOB in the output and your environment is approved for it.\n",
                "DROP_BIRTH_DATE = True\n",
                "\n",
                "# Initials are also an identifier. They appear in the original RCC filenames\n",
                "# and are useful for eyeballing matches, so they are kept by default.\n",
                "DROP_INITIALS = False\n",
                "\n",
                "# ---- what to do with the RCC files themselves ------------------------------\n",
                "#   \"map_only\"  -> write the old->new lookup, touch nothing on disk  (default)\n",
                "#   \"copy_flat\" -> copy renamed files into OUT/renamed/\n",
                "#   \"copy_tree\" -> copy into OUT/renamed/<diagnosis>/<patient_id>/\n",
                "RENAME_MODE = \"map_only\"\n",
                "\n",
                "# Put EVERY probe's raw count (endogenous genes, housekeeping, positive and\n",
                "# negative controls, ~90 columns) into the master CSV, not just the 36 panel\n",
                "# genes. Raw counts either way - nothing is normalised.\n",
                "INCLUDE_ALL_PROBES = True\n",
                "\n",
                "# which pieces go into the new filename (patient ID + date are always included)\n",
                "INCLUDE_INITIALS = True    # already present in the original names; aids eyeballing\n",
                "INCLUDE_DX       = True    # diagnosis slug\n",
                "INCLUDE_VISIT    = True    # v01, v02 ... ordered by sample date within patient\n",
                "INCLUDE_SPECIMEN = True    # only appended when it is NOT whole blood\n",
                "INCLUDE_LANE     = True    # lane number, keeps multiplexed runs distinct\n",
                "\n",
                "# ---- panel -----------------------------------------------------------------\n",
                "TARGET_GENES = [\n",
                "    \"CXCL10\",\"DDX60\",\"EPSTI1\",\"GBP1\",\"HERC5\",\"HERC6\",\"IFI27\",\"IFI44\",\"IFI44L\",\n",
                "    \"IFI6\",\"IFIT1\",\"IFIT2\",\"IFIT3\",\"IFIT5\",\"IFNA2\",\"IFNB1\",\"IRF7\",\"ISG15\",\n",
                "    \"LAMP3\",\"LY6E\",\"MX1\",\"OAS1\",\"OAS2\",\"OAS3\",\"OASL\",\"RSAD2\",\"RTP4\",\"SAMD9\",\n",
                "    \"SIGLEC1\",\"SOCS1\",\"SPATS2L\",\"USP18\",\n",
                "]\n",
                "HOUSEKEEPING = [\"ALAS1\",\"HPRT1\",\"TBP\",\"TUBB\"]\n",
                "\n",
                "# ---- QC thresholds (NanoString defaults) -----------------------------------\n",
                "BD_MIN, BD_MAX = 0.05, 2.25   # binding density\n",
                "FOV_MIN        = 0.75         # fraction of fields of view successfully counted\n",
                "\n",
                "pd.set_option(\"display.max_rows\", 200)\n",
                "pd.set_option(\"display.max_colwidth\", 70)\n",
                "os.makedirs(OUT, exist_ok=True)\n",
                "\n",
                "# === CELL 1b : locate the RCC files (replaces trusting FOLDER blindly) ======\n",
                "import zipfile\n",
                "\n",
                "SEARCH_ROOTS  = [\"/home/jovyan\", \"/mnt/session_data\", \"/mnt\"]\n",
                "MAX_DEPTH     = 5\n",
                "EXTRACT_TO    = \"/home/jovyan/rcc_extracted\"     # used only if the files are zipped\n",
                "\n",
                "def _scan(roots, max_depth=MAX_DEPTH):\n",
                "    \"\"\"-> ({dir: n_rcc}, [zip paths]). Skips hidden dirs and python packages.\"\"\"\n",
                "    found, zips, seen = {}, [], set()\n",
                "    for root in roots:\n",
                "        if not os.path.isdir(root):\n",
                "            continue\n",
                "        base = root.rstrip(os.sep).count(os.sep)\n",
                "        for dp, dn, fn in os.walk(root):\n",
                "            rp = os.path.realpath(dp)\n",
                "            if rp in seen:\n",
                "                dn[:] = []; continue\n",
                "            seen.add(rp)\n",
                "            if dp.count(os.sep) - base >= max_depth:\n",
                "                dn[:] = []\n",
                "            dn[:] = [d for d in dn if not d.startswith(\".\")\n",
                "                     and d not in (\"site-packages\", \"node_modules\", \"__pycache__\")]\n",
                "            n = sum(f.lower().endswith(\".rcc\") for f in fn)\n",
                "            if n:\n",
                "                found[dp] = n\n",
                "            zips += [os.path.join(dp, f) for f in fn if f.lower().endswith(\".zip\")]\n",
                "    return found, zips\n",
                "\n",
                "def find_rcc_folder(hint):\n",
                "    if os.path.isdir(hint) and any(f.lower().endswith(\".rcc\") for f in os.listdir(hint)):\n",
                "        return hint\n",
                "    print(f\"{hint} missing or has no .RCC files - searching...\")\n",
                "    found, zips = _scan(SEARCH_ROOTS)\n",
                "\n",
                "    if not found and zips:                       # maybe they are still zipped\n",
                "        for z in zips:\n",
                "            try:\n",
                "                with zipfile.ZipFile(z) as zf:\n",
                "                    if any(m.lower().endswith(\".rcc\") for m in zf.namelist()):\n",
                "                        print(f\"extracting {z} -> {EXTRACT_TO}\")\n",
                "                        zf.extractall(EXTRACT_TO)\n",
                "            except zipfile.BadZipFile:\n",
                "                continue\n",
                "        found, _ = _scan([EXTRACT_TO])\n",
                "\n",
                "    if not found:\n",
                "        raise FileNotFoundError(\n",
                "            \"No .RCC files or RCC-containing zips under \"\n",
                "            f\"{SEARCH_ROOTS}. Zips seen: {zips[:10] or 'none'}. \"\n",
                "            \"Set FOLDER in Cell 1 to the right place.\")\n",
                "\n",
                "    ranked = sorted(found.items(), key=lambda kv: -kv[1])\n",
                "    for d, n in ranked[:5]:\n",
                "        print(f\"  {n:6d} RCC files  {d}\")\n",
                "    best = ranked[0][0]\n",
                "    print(f\"using {best}\")\n",
                "    return best\n",
                "\n",
                "FOLDER = find_rcc_folder(FOLDER)\n",
                "# === CELL 2 : vocabulary and ID helpers =====================================\n",
                "\n",
                "def normalize_id(x):\n",
                "    \"\"\"O-6033 -> O6033, c6441 -> C6441, 1013.0 -> 1013, LD0195.0 -> LD0195.\"\"\"\n",
                "    if x is None:\n",
                "        return \"\"\n",
                "    s = str(x).strip()\n",
                "    if s.lower() in (\"nan\", \"none\", \"nat\", \"\"):\n",
                "        return \"\"\n",
                "    s = re.sub(r\"\\.0$\", \"\", s)   # Excel float suffix\n",
                "    return s.upper().replace(\"-\", \"\").replace(\" \", \"\").replace(\"_\", \"\")\n",
                "\n",
                "def slug(s, maxlen=18):\n",
                "    \"\"\"Free text -> a short uppercase token safe for filenames and tags.\"\"\"\n",
                "    s = re.sub(r\"[^A-Za-z0-9]+\", \"-\", str(s or \"\")).strip(\"-\").upper()\n",
                "    return s[:maxlen].strip(\"-\")\n",
                "\n",
                "\n",
                "def norm_colname(c):\n",
                "    return re.sub(r\"[^a-z0-9]\", \"\", str(c).lower())\n",
                "\n",
                "\n",
                "# --- specimen: WHAT the sample is. Independent of WHOSE it is. --------------\n",
                "# Order matters; first hit wins. Anything unmatched is assumed whole blood,\n",
                "# which is what the overwhelming majority of these runs are.\n",
                "SPECIMEN_PATTERNS = [\n",
                "    (\"PBMC\",         r\"\\bpbmcs?\\b\"),\n",
                "    (\"monocyte\",     r\"monocyt|\\bmonos?\\b\"),\n",
                "    (\"neutrophil\",   r\"neutroph?il?|\\bpmns?\\b\"),\n",
                "    (\"CD4_Tcell\",    r\"\\bcd4\\b\"),\n",
                "    (\"CD8_Tcell\",    r\"\\bcd8\\b\"),\n",
                "    (\"NK_cell\",      r\"\\bnk[\\s_-]*cells?\\b\"),\n",
                "    (\"B_cell\",       r\"\\bb[\\s_-]*cells?\\b\"),\n",
                "    (\"T_cell\",       r\"\\bt[\\s_-]*cells?\\b\"),\n",
                "    (\"lymphocyte\",   r\"lymphocyt\"),\n",
                "    (\"macrophage\",   r\"macrophages?|\\bmdms?\\b\"),\n",
                "    (\"BAL\",          r\"\\bbals?\\b|bronchoalveolar\"),\n",
                "    (\"lung_tissue\",  r\"\\blung\\b\"),\n",
                "    (\"liver_tissue\", r\"bio\\s*liv|\\bliver\\b\"),\n",
                "    (\"fibroblast\",   r\"fibroblast|\\bfibs?\\b\"),\n",
                "    (\"keratinocyte\", r\"keratinocyt\"),\n",
                "    (\"bone_marrow\",  r\"bone\\s*marrow\"),\n",
                "    (\"skin_biopsy\",  r\"\\bskin\\b|biopsy\"),\n",
                "]\n",
                "DEFAULT_SPECIMEN = \"whole_blood\"\n",
                "\n",
                "# --- evidence patterns: WHAT KIND of record it is ---------------------------\n",
                "STANDARD_PAT    = re.compile(r\"(sd[\\s_]*tube|sdtube|\\bsd\\d\\b|\\bsst\\b|standard|\\b\\d+\\s*ds\\b)\", re.I)\n",
                "PLACEHOLDER_PAT = re.compile(r\"\\b(xyz|dummy|test)\\b|\\bsample\\d+\\b\", re.I)\n",
                "CONTROL_PAT     = re.compile(r\"\\bhc\\d?\\b|healthy|\\bhk\\d*\\b|\\brv\\d|bio\\s*liv\\s*control|\\bcontrol\\b\", re.I)\n",
                "OTHER_COHORT_PAT= re.compile(r\"HGR\\d|PAX-|NAP\\d|PIMS|NIH\\d|STANF|-APAH|\\bNH-?[CP]?\\d|\"\n",
                "                             r\"\\bIDT[\\s-]|KFSHRC|HERSEI|\\bBS[\\s-]?RG\\b|BS-SPECIAL\", re.I)\n",
                "COVID_PAT       = re.compile(r\"covid|\\bcv\\d|CV0\\d\", re.I)\n",
                "STIM_PAT        = re.compile(r\"\\bTNF\\b|\\bLPS\\b|\\bpIC\\b|\\bKLA\\b|\\bIFN[ab]?\\s*stim|\"\n",
                "                             r\"\\+\\s*G\\b|\\bG\\d\\b|\\bNT\\b|\\bWT\\b|\\bV\\d{2,3}[A-Z]\\b|SAVI|SAMD9?L?\\s*mut|\"\n",
                "                             r\"\\b\\d+\\s*min\\b\", re.I)\n",
                "TIMEPOINT_PAT   = re.compile(r\"\\b\\d+\\s*h(r|rs)?\\b|\\b\\d+h\\b|\\bt0\\b|\\bt1\\b|PREAM|PREPM|POSTAM|POSTPM|\"\n",
                "                             r\"premorn|post-?infusion|\\bBSL\\b|\\bbaseline\\b|run\\s*2\", re.I)\n",
                "\n",
                "# --- parsing patterns -------------------------------------------------------\n",
                "MMDDYY        = re.compile(r\"\\b(\\d{6})\\b\")\n",
                "ID_IN_FIELD   = re.compile(r\"\\b([ROCP]-?\\d{3,5}|O\\d{4}|\\d{2}-\\d{3}[A-Z]?|\\d{4})\\b\", re.I)\n",
                "INITIALS_LEAD = re.compile(r\"^(?:\\d{2})?\\s*([A-Za-z]{2,5}\\d?)\\+?[\\s_-]\", re.I)\n",
                "OP_FROM_CART  = re.compile(r\"([A-Za-z]{2,5})\")\n",
                "\n",
                "# --- manual override layer --------------------------------------------------\n",
                "# These win over anything auto-derived from the metadata file. Add to them as\n",
                "# you resolve rows flagged needs_review.\n",
                "MANUAL_INITIALS_MAP = {k: normalize_id(v) for k, v in {\n",
                "    \"AMG\":\"1074\",\"AMK\":\"1406\",\"AMK2\":\"C-6450\",\"AMKT\":\"1257\",\"ANV\":\"1613\",\n",
                "    \"ANV2\":\"R2093\",\"AWT\":\"1385\",\"CEG\":\"1166\",\"CEG2\":\"1384\",\"EDS\":\"1469\",\n",
                "    \"FNU\":\"1457\",\"HBS\":\"2052\",\"IRB\":\"1013\",\"IRB2\":\"R1049\",\"JJK\":\"1048\",\n",
                "    \"JMM\":\"2308\",\"JMM2\":\"O-6155\",\"JTD\":\"1565\",\"KAC2\":\"C-6589\",\"KMM\":\"C-6575\",\n",
                "    \"KVR\":\"1188\",\"LNM2\":\"2355\",\"MAF\":\"2209\",\"MES\":\"2342\",\"MES2\":\"R2398\",\n",
                "    \"MES3\":\"C-6434\",\"MSV\":\"2276\",\"MSW\":\"C-6567\",\"NBM\":\"1588\",\"NBM2\":\"1676\",\n",
                "    \"NTJM\":\"1377\",\"OPS\":\"2106\",\"PEDS\":\"R1831\",\"RNS\":\"R1780\",\"RNS2\":\"R2100\",\n",
                "    \"SNT\":\"1340\",\"SNT2\":\"2077\",\"SNT3\":\"R2078\",\"SNT4\":\"R2396\",\"TMS2\":\"C-6649\",\n",
                "    \"TRAM\":\"1370\",\"YNC2\":\"1754\",\n",
                "}.items()}\n",
                "\n",
                "# (initials, wrong_id_as_written) -> correct_id. Only add after you have\n",
                "# confirmed it against the enrollment database.\n",
                "VERIFIED_TYPOS = {(k[0], normalize_id(k[1])): normalize_id(v) for k, v in {\n",
                "    (\"IRB\", \"1000\"): \"1013\",\n",
                "}.items()}\n",
                "\n",
                "# initials you already know are ambiguous and should never be auto-filled\n",
                "KNOWN_AMBIGUOUS = {\"ANV\",\"MAF\",\"MES\",\"RNS\",\"EOS\",\"KNM2\",\"LHSC\",\"VNC\",\"XXX\"}\n",
                "\n",
                "\n",
                "# === CELL 3 : RCC file parser ===============================================\n",
                "SECTION_RE = re.compile(r\"<(\\w+)>(.*?)</\\1>\", re.S)\n",
                "\n",
                "\n",
                "def _kv_block(text):\n",
                "    \"\"\"Parse a 'Key,Value' block into a dict.\"\"\"\n",
                "    d = {}\n",
                "    for line in text.splitlines():\n",
                "        line = line.strip()\n",
                "        if not line or \",\" not in line:\n",
                "            continue\n",
                "        k, _, v = line.partition(\",\")\n",
                "        k = k.strip()\n",
                "        if k:\n",
                "            d[k] = v.strip()\n",
                "    return d\n",
                "\n",
                "\n",
                "def parse_rcc(path):\n",
                "    \"\"\"Return (attrs dict, list of (code_class, gene, accession, count)).\"\"\"\n",
                "    with open(path, \"r\", errors=\"replace\") as fh:\n",
                "        txt = fh.read()\n",
                "\n",
                "    sections = {m.group(1): m.group(2) for m in SECTION_RE.finditer(txt)}\n",
                "\n",
                "    # Tolerate files with a missing closing tag: fall back to a forward scan.\n",
                "    if \"Code_Summary\" not in sections and \"<Code_Summary>\" in txt:\n",
                "        sections[\"Code_Summary\"] = txt.split(\"<Code_Summary>\", 1)[1]\n",
                "    if not sections:\n",
                "        sections = {\"Sample_Attributes\": txt[:3000]}\n",
                "\n",
                "    hdr  = _kv_block(sections.get(\"Header\", \"\"))\n",
                "    samp = _kv_block(sections.get(\"Sample_Attributes\", \"\"))\n",
                "    lane = _kv_block(sections.get(\"Lane_Attributes\", \"\"))\n",
                "\n",
                "    counts = []\n",
                "    for line in sections.get(\"Code_Summary\", \"\").splitlines():\n",
                "        line = line.strip()\n",
                "        if not line or line.startswith(\"<\"):\n",
                "            continue\n",
                "        parts = line.split(\",\")\n",
                "        if len(parts) < 4:\n",
                "            continue\n",
                "        cc, nm, acc, ct = (p.strip() for p in parts[:4])\n",
                "        if cc.lower() == \"codeclass\":\n",
                "            continue\n",
                "        try:\n",
                "            ct = int(float(ct))\n",
                "        except ValueError:\n",
                "            continue\n",
                "        counts.append((cc, nm, acc, ct))\n",
                "\n",
                "    attrs = {\n",
                "        \"id_field_raw\":   samp.get(\"ID\", \"\"),\n",
                "        \"sample_owner\":   samp.get(\"Owner\", \"\"),\n",
                "        \"sample_comment\": samp.get(\"Comments\", \"\"),\n",
                "        \"run_date_raw\":   samp.get(\"Date\", \"\"),\n",
                "        \"gene_rlf\":       samp.get(\"GeneRLF\", \"\") or hdr.get(\"GeneRLF\", \"\"),\n",
                "        \"lane_id\":        lane.get(\"ID\", \"\"),\n",
                "        \"fov_count\":      lane.get(\"FovCount\", \"\"),\n",
                "        \"fov_counted\":    lane.get(\"FovCounted\", \"\"),\n",
                "        \"binding_density\":lane.get(\"BindingDensity\", \"\"),\n",
                "        \"cartridge\":      lane.get(\"CartridgeID\", \"\"),\n",
                "        \"scanner_id\":     lane.get(\"ScannerID\", \"\"),\n",
                "        \"rcc_version\":    hdr.get(\"FileVersion\", \"\"),\n",
                "        \"n_probes\":       len(counts),\n",
                "    }\n",
                "    return attrs, counts\n",
                "\n",
                "\n",
                "def _geomean(vals):\n",
                "    vals = [v for v in vals if v is not None and v > 0]\n",
                "    if not vals:\n",
                "        return np.nan\n",
                "    return float(np.exp(np.mean(np.log(vals))))\n",
                "\n",
                "\n",
                "def qc_from_counts(counts):\n",
                "    \"\"\"Standard NanoString QC. Not an IFN score - just run health.\"\"\"\n",
                "    pos = [c for cls, nm, _, c in counts if cls.lower().startswith(\"pos\")]\n",
                "    neg = [c for cls, nm, _, c in counts if cls.lower().startswith(\"neg\")]\n",
                "    hk  = {nm: c for cls, nm, _, c in counts\n",
                "           if cls.lower().startswith(\"house\") or nm.upper() in HOUSEKEEPING}\n",
                "    endo = [c for cls, nm, _, c in counts if cls.lower().startswith(\"endo\")]\n",
                "\n",
                "    neg_mean = float(np.mean(neg)) if neg else np.nan\n",
                "    neg_sd   = float(np.std(neg, ddof=1)) if len(neg) > 1 else np.nan\n",
                "    lod      = neg_mean + 2 * neg_sd if neg else np.nan\n",
                "\n",
                "    return {\n",
                "        \"pos_control_geomean\": _geomean(pos),\n",
                "        \"neg_control_mean\":    neg_mean,\n",
                "        \"limit_of_detection\":  lod,\n",
                "        \"hk_geomean\":          _geomean(list(hk.values())),\n",
                "        \"n_housekeeping\":      len(hk),\n",
                "        \"n_endogenous\":        len(endo),\n",
                "        \"total_counts\":        int(sum(endo)) if endo else 0,\n",
                "        \"n_genes_above_lod\":   int(sum(1 for c in endo if not np.isnan(lod) and c > lod)) if endo else 0,\n",
                "    }\n",
                "\n",
                "\n",
                "# === CELL 4 : field parsing, specimen, record type ==========================\n",
                "\n",
                "def parse_id_field(s):\n",
                "    \"\"\"Pull initials / patient id / date / plate position out of the ID string.\"\"\"\n",
                "    out = dict(sample_initials=\"\", patient_id_raw=\"\", sample_date_raw=\"\", position=\"\")\n",
                "    if not s:\n",
                "        return out\n",
                "    s = s.strip()\n",
                "\n",
                "    m = re.match(r\"^(\\d{2})\\s+([ROCP]-?\\d{3,5}|\\d{4})$\", s)      # \"09 1013\"\n",
                "    if m:\n",
                "        out[\"position\"], out[\"patient_id_raw\"] = m.group(1), m.group(2)\n",
                "        return out\n",
                "    if re.fullmatch(r\"\\d{1,2}\", s):                               # bare position\n",
                "        out[\"position\"] = s\n",
                "        return out\n",
                "\n",
                "    mpos = re.match(r\"^(\\d{2})(?=[A-Za-z])\", s)                   # \"03JNZA-...\"\n",
                "    if mpos:\n",
                "        out[\"position\"] = mpos.group(1)\n",
                "\n",
                "    m = INITIALS_LEAD.match(s)\n",
                "    if m:\n",
                "        out[\"sample_initials\"] = m.group(1).upper()\n",
                "\n",
                "    dates = [d for d in MMDDYY.findall(s)\n",
                "             if 1 <= int(d[:2]) <= 12 and 1 <= int(d[2:4]) <= 31]\n",
                "    if dates:\n",
                "        out[\"sample_date_raw\"] = dates[-1]\n",
                "\n",
                "    for m in ID_IN_FIELD.finditer(s):\n",
                "        tok = m.group(1)\n",
                "        if tok not in dates and tok.upper() != out[\"sample_initials\"]:\n",
                "            out[\"patient_id_raw\"] = tok.upper()\n",
                "            break\n",
                "    return out\n",
                "\n",
                "\n",
                "def detect_specimen(blob):\n",
                "    for name, pat in SPECIMEN_PATTERNS:\n",
                "        if re.search(pat, blob, re.I):\n",
                "            return name\n",
                "    return DEFAULT_SPECIMEN\n",
                "\n",
                "\n",
                "def detect_evidence(blob):\n",
                "    return {\n",
                "        \"is_standard\":     bool(STANDARD_PAT.search(blob)),\n",
                "        \"is_placeholder\":  bool(PLACEHOLDER_PAT.search(blob)),\n",
                "        \"is_control\":      bool(CONTROL_PAT.search(blob)),\n",
                "        \"is_other_cohort\": bool(OTHER_COHORT_PAT.search(blob)),\n",
                "        \"is_covid\":        bool(COVID_PAT.search(blob)),\n",
                "        \"is_stimulation\":  bool(STIM_PAT.search(blob)),\n",
                "        \"has_timepoint\":   bool(TIMEPOINT_PAT.search(blob)),\n",
                "    }\n",
                "\n",
                "\n",
                "# Any date outside this window is treated as a typo and dropped (-> NaT), so a\n",
                "# bad year like 31 (-> 1931) or 30 (-> 2030) can never reach age or batch logic.\n",
                "# Edit DATE_MIN if your earliest real run is earlier than 2008.\n",
                "DATE_MIN = pd.Timestamp(\"2008-01-01\")\n",
                "DATE_MAX = pd.Timestamp.today().normalize()\n",
                "\n",
                "\n",
                "def _in_window(d):\n",
                "    return d if (pd.notna(d) and DATE_MIN <= d <= DATE_MAX) else pd.NaT\n",
                "\n",
                "\n",
                "def parse_sample_date(mmddyy):\n",
                "    \"\"\"MMDDYY -> Timestamp. Two-digit years <=30 are 2000s.\n",
                "    Returns NaT if the result is outside DATE_MIN..DATE_MAX.\"\"\"\n",
                "    if not mmddyy or len(mmddyy) != 6:\n",
                "        return pd.NaT\n",
                "    mm, dd, yy = int(mmddyy[:2]), int(mmddyy[2:4]), int(mmddyy[4:])\n",
                "    year = 2000 + yy if yy <= 30 else 1900 + yy\n",
                "    try:\n",
                "        return _in_window(pd.Timestamp(year=year, month=mm, day=dd))\n",
                "    except ValueError:\n",
                "        return pd.NaT\n",
                "\n",
                "\n",
                "def parse_run_date(raw, filename):\n",
                "    for cand in (raw, (re.match(r\"^(\\d{8})\", filename) or [None, \"\"])[0]):\n",
                "        if not cand:\n",
                "            continue\n",
                "        for fmt in (\"%Y%m%d\", \"%m/%d/%Y\", \"%Y-%m-%d\", \"%m/%d/%y\"):\n",
                "            try:\n",
                "                d = _in_window(pd.Timestamp(datetime.strptime(str(cand).strip(), fmt)))\n",
                "                if pd.notna(d):\n",
                "                    return d\n",
                "            except (ValueError, TypeError):\n",
                "                continue\n",
                "    return pd.NaT\n",
                "\n",
                "\n",
                "FNAME_DATE8 = re.compile(r\"(?<!\\d)(20\\d{2})(\\d{2})(\\d{2})(?!\\d)\")\n",
                "FNAME_DATE6 = re.compile(r\"(?<!\\d)(\\d{6})(?!\\d)\")\n",
                "\n",
                "\n",
                "def _ymd(y, m, d):\n",
                "    try:\n",
                "        return _in_window(pd.Timestamp(year=y, month=m, day=d))\n",
                "    except ValueError:\n",
                "        return pd.NaT\n",
                "\n",
                "\n",
                "def date_from_filename(filename):\n",
                "    \"\"\"Pull a date out of the RCC filename. YYYYMMDD first, then MMDDYY/YYMMDD.\"\"\"\n",
                "    stem = os.path.splitext(filename)[0]\n",
                "    m = FNAME_DATE8.search(stem)\n",
                "    if m:\n",
                "        d = _ymd(int(m.group(1)), int(m.group(2)), int(m.group(3)))\n",
                "        if pd.notna(d):\n",
                "            return d\n",
                "    for m in FNAME_DATE6.finditer(stem):\n",
                "        tok = m.group(1)\n",
                "        d = parse_sample_date(tok)                               # MMDDYY\n",
                "        if pd.isna(d):                                           # then YYMMDD\n",
                "            yy, mm, dd = int(tok[:2]), int(tok[2:4]), int(tok[4:])\n",
                "            d = _ymd(2000 + yy if yy <= 30 else 1900 + yy, mm, dd)\n",
                "        if pd.notna(d):\n",
                "            return d\n",
                "    return pd.NaT\n",
                "\n",
                "\n",
                "def resolve_sample_date(sample_date_raw):\n",
                "    \"\"\"Date the sample was COLLECTED. Only the RCC ID field carries this.\n",
                "\n",
                "    The date in the filename is the NanoString run date, not the collection\n",
                "    date - samples often sit frozen for months or years before being run - so\n",
                "    it is deliberately not used here. If the ID field has no date, collection\n",
                "    date is unknown and stays blank rather than being quietly faked.\n",
                "    \"\"\"\n",
                "    d = parse_sample_date(sample_date_raw)\n",
                "    return (d, \"id_field\") if pd.notna(d) else (pd.NaT, \"none\")\n",
                "\n",
                "\n",
                "def resolve_run_date(run_date_raw, filename):\n",
                "    \"\"\"Date the cartridge was RUN. Instrument header first, then filename.\"\"\"\n",
                "    d = parse_run_date(run_date_raw, \"\")\n",
                "    if pd.notna(d):\n",
                "        return d, \"rcc_date_header\"\n",
                "    d = date_from_filename(filename)\n",
                "    if pd.notna(d):\n",
                "        return d, \"filename\"\n",
                "    return pd.NaT, \"none\"\n",
                "\n",
                "\n",
                "def build_row(filename, folder):\n",
                "    attrs, counts = parse_rcc(os.path.join(folder, filename))\n",
                "    row = dict(raw_filename=filename, **attrs)\n",
                "    row.update(parse_id_field(attrs[\"id_field_raw\"]))\n",
                "\n",
                "    blob = f\"{attrs['id_field_raw']} {attrs['sample_comment']} {filename}\"\n",
                "    row[\"specimen_type\"] = detect_specimen(blob)\n",
                "    row.update(detect_evidence(blob))\n",
                "\n",
                "    row[\"sample_date\"], row[\"sample_date_source\"] = resolve_sample_date(\n",
                "        row[\"sample_date_raw\"])\n",
                "    row[\"run_date\"], row[\"run_date_source\"] = resolve_run_date(\n",
                "        attrs[\"run_date_raw\"], filename)\n",
                "\n",
                "    ops = OP_FROM_CART.findall(\n",
                "        re.sub(r\"\\d{8}|\\d{2}-\\d{2}-\\d{2}\", \"\", attrs[\"cartridge\"]))\n",
                "    row[\"operator\"] = ops[-1] if ops else \"\"\n",
                "\n",
                "    # numeric QC straight off the lane attributes\n",
                "    try:\n",
                "        row[\"binding_density\"] = float(attrs[\"binding_density\"])\n",
                "    except (TypeError, ValueError):\n",
                "        row[\"binding_density\"] = np.nan\n",
                "    try:\n",
                "        row[\"fov_ratio\"] = float(attrs[\"fov_counted\"]) / float(attrs[\"fov_count\"])\n",
                "    except (TypeError, ValueError, ZeroDivisionError):\n",
                "        row[\"fov_ratio\"] = np.nan\n",
                "\n",
                "    row.update(qc_from_counts(counts))\n",
                "    return row, counts\n",
                "\n",
                "\n",
                "# === CELL 5 : read every file ===============================================\n",
                "files = sorted(f for f in os.listdir(FOLDER) if f.lower().endswith(\".rcc\"))\n",
                "print(f\"{len(files)} RCC files in {FOLDER}\")\n",
                "\n",
                "rows, long_counts, parse_errors = [], [], []\n",
                "for i, fn in enumerate(files):\n",
                "    try:\n",
                "        row, counts = build_row(fn, FOLDER)\n",
                "        rows.append(row)\n",
                "        for cls, gene, acc, ct in counts:\n",
                "            long_counts.append((fn, cls, gene, acc, ct))\n",
                "    except Exception as exc:                                  # noqa: BLE001\n",
                "        parse_errors.append({\"raw_filename\": fn, \"error\": f\"{type(exc).__name__}: {exc}\"})\n",
                "    if i % 1000 == 0:\n",
                "        print(f\"  ...{i}/{len(files)}\")\n",
                "\n",
                "df = pd.DataFrame(rows)\n",
                "errors_df = pd.DataFrame(parse_errors)\n",
                "\n",
                "counts_long = pd.DataFrame(long_counts,\n",
                "                           columns=[\"raw_filename\", \"code_class\", \"gene\", \"accession\", \"count\"])\n",
                "for col in (\"code_class\", \"gene\", \"accession\"):\n",
                "    counts_long[col] = counts_long[col].astype(\"category\")\n",
                "\n",
                "print(f\"\\nparsed {len(df)} files, {len(errors_df)} failures, \"\n",
                "      f\"{len(counts_long):,} probe measurements\")\n",
                "if not df.empty:\n",
                "    print(\"\\ncodesets present (GeneRLF):\")\n",
                "    print(df[\"gene_rlf\"].value_counts().head(20))\n",
                "\n",
                "\n",
                "# === CELL 6 : metadata ======================================================\n",
                "\n",
                "def _find_col(columns, *wanted):\n",
                "    \"\"\"Match a column name ignoring case, spaces, and punctuation.\"\"\"\n",
                "    norm = {re.sub(r\"[^a-z0-9]\", \"\", c.lower()): c for c in columns}\n",
                "    for w in wanted:\n",
                "        key = re.sub(r\"[^a-z0-9]\", \"\", w.lower())\n",
                "        if key in norm:\n",
                "            return norm[key]\n",
                "    return None\n",
                "\n",
                "\n",
                "SHEET_EXTS = (\".csv\", \".xlsx\", \".xls\", \".tsv\")\n",
                "\n",
                "\n",
                "def _spreadsheets_in(d, max_depth=0):\n",
                "    \"\"\"Spreadsheet files in d, optionally descending max_depth levels.\"\"\"\n",
                "    found = []\n",
                "    if not os.path.isdir(d):\n",
                "        return found\n",
                "    base_depth = d.rstrip(os.sep).count(os.sep)\n",
                "    for root, dirs, files in os.walk(d):\n",
                "        dirs[:] = [x for x in dirs if not x.startswith(\".\")]\n",
                "        if root.rstrip(os.sep).count(os.sep) - base_depth >= max_depth:\n",
                "            dirs[:] = []\n",
                "        for f in files:\n",
                "            if f.lower().endswith(SHEET_EXTS) and not f.startswith(\"~$\"):\n",
                "                found.append(os.path.join(root, f))\n",
                "    return found\n",
                "\n",
                "\n",
                "def load_metadata(folder, pattern):\n",
                "    \"\"\"Find the metadata file without caring about capitalisation.\n",
                "\n",
                "    Linux globbing is case-sensitive, so 'MetadataPatients_NoPHI*' misses\n",
                "    'metadatapatients_nophi.xlsx'. This compares names with punctuation and\n",
                "    case stripped out, looks in the RCC folder, its parent, and anything in\n",
                "    METADATA_SEARCH_DIRS, and if it still finds nothing it tells you what\n",
                "    spreadsheets it did see instead of leaving you guessing.\n",
                "    \"\"\"\n",
                "    want = re.sub(r\"[^a-z0-9]\", \"\", pattern.lower().replace(\"*\", \"\"))\n",
                "\n",
                "    pool, seen = [], set()\n",
                "    for d, depth in ([(folder, 0), (os.path.dirname(folder.rstrip(os.sep)), 1)]\n",
                "                     + [(x, 2) for x in METADATA_SEARCH_DIRS]):\n",
                "        for p in _spreadsheets_in(d, max_depth=depth):\n",
                "            rp = os.path.realpath(p)\n",
                "            if rp not in seen:\n",
                "                seen.add(rp)\n",
                "                pool.append(p)\n",
                "\n",
                "    def key(p):\n",
                "        return re.sub(r\"[^a-z0-9]\", \"\",\n",
                "                      os.path.splitext(os.path.basename(p))[0].lower())\n",
                "\n",
                "    hits = [p for p in pool if key(p).startswith(want)]\n",
                "    if not hits:\n",
                "        hits = [p for p in pool if want in key(p)]\n",
                "    if not hits:                      # last resort: looks metadata-ish\n",
                "        hits = [p for p in pool\n",
                "                if (\"metadata\" in key(p)\n",
                "                    or (\"patient\" in key(p) and \"nanostring\" not in key(p)))]\n",
                "\n",
                "    if not hits:\n",
                "        listing = \"\\n\".join(f\"    {p}\" for p in sorted(pool)[:40]) or \"    (none)\"\n",
                "        raise FileNotFoundError(\n",
                "            f\"No metadata file matching {pattern!r} near {folder}.\\n\"\n",
                "            f\"Spreadsheets I can see:\\n{listing}\\n\"\n",
                "            \"Set METADATA_GLOB to the right name, or add its folder to \"\n",
                "            \"METADATA_SEARCH_DIRS, in Cell 1.\")\n",
                "\n",
                "    # prefer a file sitting in FOLDER itself, then the shallowest path\n",
                "    hits.sort(key=lambda p: (os.path.dirname(os.path.realpath(p))\n",
                "                             != os.path.realpath(folder),\n",
                "                             p.count(os.sep), p))\n",
                "    path = hits[0]\n",
                "    if len(hits) > 1:\n",
                "        print(f\"note: {len(hits)} candidates, using {path}\")\n",
                "        for p in hits[1:5]:\n",
                "            print(f\"      (ignoring {p})\")\n",
                "\n",
                "    ext = os.path.splitext(path)[1].lower()\n",
                "    if ext in (\".xlsx\", \".xls\"):\n",
                "        sheets = pd.read_excel(path, sheet_name=None, dtype=str)\n",
                "        # pick the sheet that actually looks like the patient table\n",
                "        name, md = max(sheets.items(),\n",
                "                       key=lambda kv: (sum(1 for c in kv[1].columns\n",
                "                                           if re.search(r\"enroll|diagnos|initial\",\n",
                "                                                        str(c), re.I)),\n",
                "                                       len(kv[1])))\n",
                "        if len(sheets) > 1:\n",
                "            print(f\"workbook has {len(sheets)} sheets, using {name!r}\")\n",
                "    elif ext == \".tsv\":\n",
                "        md = pd.read_csv(path, dtype=str, sep=\"\\t\")\n",
                "    else:\n",
                "        md = pd.read_csv(path, dtype=str)\n",
                "\n",
                "    md.columns = [str(c).strip() for c in md.columns]\n",
                "    md = md.dropna(how=\"all\").reset_index(drop=True)\n",
                "    print(f\"metadata: {path}  ({len(md)} rows)\")\n",
                "    print(\"columns:\", list(md.columns))\n",
                "    return md, path\n",
                "\n",
                "\n",
                "md, md_path = load_metadata(FOLDER, METADATA_GLOB)\n",
                "\n",
                "if METADATA_EXTRA:\n",
                "    _SYN = [(\"Enrollment ID\", \"EnrollmentID\"),\n",
                "            (\"Alternate Enrollment ID\", \"Alt Enrollment ID\"),\n",
                "            (\"Initials\",), (\"Birth Date\", \"DOB\", \"BirthDate\"),\n",
                "            (\"Sex\", \"Gender\"), (\"Race\",), (\"Ethnicity\",),\n",
                "            (\"Study Status\", \"Status\"), (\"Diagnosis1\", \"Diagnosis 1\"),\n",
                "            (\"Diagnosis2\", \"Diagnosis 2\"), (\"Note\", \"Notes\")]\n",
                "    _parts = [md]\n",
                "    for _p in METADATA_EXTRA:\n",
                "        if not os.path.exists(_p):\n",
                "            raise FileNotFoundError(f\"METADATA_EXTRA file not found: {_p}\")\n",
                "        if _p.lower().endswith((\".xlsx\", \".xls\")):\n",
                "            _ex = pd.read_excel(_p, dtype=str)\n",
                "        elif _p.lower().endswith(\".tsv\"):\n",
                "            _ex = pd.read_csv(_p, dtype=str, sep=\"\\t\")\n",
                "        else:\n",
                "            _ex = pd.read_csv(_p, dtype=str)\n",
                "        _ex.columns = [str(c).strip() for c in _ex.columns]\n",
                "        _ex = _ex.dropna(how=\"all\")\n",
                "        _ren = {}\n",
                "        for _names in _SYN:\n",
                "            _src, _dst = _find_col(_ex.columns, *_names), _find_col(md.columns, *_names)\n",
                "            if _src and _dst and _src != _dst:\n",
                "                _ren[_src] = _dst\n",
                "        _ex = _ex.rename(columns=_ren).reindex(columns=md.columns)\n",
                "        print(f\"extra patients: {_p}  (+{len(_ex)} rows)\")\n",
                "        _parts.append(_ex)\n",
                "    md = pd.concat(_parts, ignore_index=True)\n",
                "    print(f\"metadata now {len(md)} rows (main sheet first, so it wins on duplicate IDs)\")\n",
                "\n",
                "COL = {\n",
                "    \"enroll\":     _find_col(md.columns, \"Enrollment ID\", \"EnrollmentID\"),\n",
                "    \"alt_enroll\": _find_col(md.columns, \"Alternate Enrollment ID\", \"Alt Enrollment ID\"),\n",
                "    \"initials\":   _find_col(md.columns, \"Initials\"),\n",
                "    \"dob\":        _find_col(md.columns, \"Birth Date\", \"DOB\", \"BirthDate\"),\n",
                "    \"sex\":        _find_col(md.columns, \"Sex\", \"Gender\"),\n",
                "    \"race\":       _find_col(md.columns, \"Race\"),\n",
                "    \"ethnicity\":  _find_col(md.columns, \"Ethnicity\"),\n",
                "    \"status\":     _find_col(md.columns, \"Study Status\", \"Status\"),\n",
                "    \"dx1\":        _find_col(md.columns, \"Diagnosis1\", \"Diagnosis 1\"),\n",
                "    \"dx2\":        _find_col(md.columns, \"Diagnosis2\", \"Diagnosis 2\"),\n",
                "    \"note\":       _find_col(md.columns, \"Note\", \"Notes\"),\n",
                "}\n",
                "missing = [k for k, v in COL.items() if v is None]\n",
                "if missing:\n",
                "    print(f\"warning: metadata columns not found, will be blank: {missing}\")\n",
                "\n",
                "# --- lookup on both enrollment ID columns -----------------------------------\n",
                "meta_lookup, dup_keys = {}, []\n",
                "for idx, r in md.iterrows():\n",
                "    for key_col in (COL[\"enroll\"], COL[\"alt_enroll\"]):\n",
                "        if not key_col:\n",
                "            continue\n",
                "        k = normalize_id(r.get(key_col))\n",
                "        if not k:\n",
                "            continue\n",
                "        if k in meta_lookup and meta_lookup[k] != idx:\n",
                "            dup_keys.append(k)\n",
                "        meta_lookup.setdefault(k, idx)\n",
                "if dup_keys:\n",
                "    print(f\"warning: {len(set(dup_keys))} enrollment IDs appear on >1 metadata row \"\n",
                "          f\"(first wins): {sorted(set(dup_keys))[:10]}\")\n",
                "\n",
                "# --- initials -> enrollment ID, derived from the metadata file --------------\n",
                "_by_initials = {}\n",
                "if COL[\"initials\"] and COL[\"enroll\"]:\n",
                "    for _, r in md.iterrows():\n",
                "        ini = str(r.get(COL[\"initials\"]) or \"\").strip().upper()\n",
                "        eid = normalize_id(r.get(COL[\"enroll\"]))\n",
                "        if ini and eid:\n",
                "            _by_initials.setdefault(ini, set()).add(eid)\n",
                "\n",
                "AUTO_INITIALS_MAP = {k: next(iter(v)) for k, v in _by_initials.items() if len(v) == 1}\n",
                "AMBIGUOUS_INITIALS = {k for k, v in _by_initials.items() if len(v) > 1} | KNOWN_AMBIGUOUS\n",
                "\n",
                "# manual entries win\n",
                "INITIALS_MAP = {**AUTO_INITIALS_MAP, **MANUAL_INITIALS_MAP}\n",
                "print(f\"\\ninitials map: {len(AUTO_INITIALS_MAP)} auto from metadata, \"\n",
                "      f\"{len(MANUAL_INITIALS_MAP)} manual overrides, \"\n",
                "      f\"{len(AMBIGUOUS_INITIALS)} ambiguous (never auto-filled)\")\n",
                "\n",
                "\n",
                "# === CELL 7 : resolve patient IDs ===========================================\n",
                "# A 1-to-1 initials->ID map learned from files that state their own ID.\n",
                "_seen = {}\n",
                "for _, r in df.iterrows():\n",
                "    pid = normalize_id(r[\"patient_id_raw\"])\n",
                "    ini = r[\"sample_initials\"]\n",
                "    if ini and pid and not r[\"is_standard\"] and not r[\"is_placeholder\"]:\n",
                "        _seen.setdefault(ini, set()).add(pid)\n",
                "FILE_LEARNED_MAP = {k: next(iter(v)) for k, v in _seen.items()\n",
                "                    if len(v) == 1 and k not in AMBIGUOUS_INITIALS}\n",
                "\n",
                "\n",
                "def resolve_identity(r):\n",
                "    \"\"\"-> (patient_id, source, needs_review, review_reason)\"\"\"\n",
                "    ini = r[\"sample_initials\"]\n",
                "    pid = normalize_id(r[\"patient_id_raw\"])\n",
                "\n",
                "    if (ini, pid) in VERIFIED_TYPOS:\n",
                "        return VERIFIED_TYPOS[(ini, pid)], \"verified_typo_correction\", False, \"\"\n",
                "\n",
                "    if pid:\n",
                "        expected = INITIALS_MAP.get(ini)\n",
                "        if expected and expected != pid:\n",
                "            return (pid, \"stated_in_file\", True,\n",
                "                    f\"file says {pid}, metadata says {ini} is {expected}\")\n",
                "        return pid, \"stated_in_file\", False, \"\"\n",
                "\n",
                "    # no ID written in the file: fill in only where it is unambiguous\n",
                "    if not ini:\n",
                "        return \"\", \"none\", False, \"\"\n",
                "    if ini in AMBIGUOUS_INITIALS:\n",
                "        return \"\", \"none\", True, f\"initials {ini} map to more than one patient, no ID in file\"\n",
                "    for src, mapping in ((\"manual_map\", MANUAL_INITIALS_MAP),\n",
                "                         (\"metadata_initials\", AUTO_INITIALS_MAP),\n",
                "                         (\"learned_from_files\", FILE_LEARNED_MAP)):\n",
                "        if ini in mapping:\n",
                "            return mapping[ini], src, False, \"\"\n",
                "    return \"\", \"none\", False, \"\"\n",
                "\n",
                "\n",
                "res = df.apply(lambda r: pd.Series(resolve_identity(r),\n",
                "                                   index=[\"patient_id\", \"id_source\",\n",
                "                                          \"needs_review\", \"review_reason\"]), axis=1)\n",
                "df = pd.concat([df, res], axis=1)\n",
                "\n",
                "# --- join metadata ----------------------------------------------------------\n",
                "df[\"meta_row\"] = df[\"patient_id\"].map(lambda p: meta_lookup.get(p, -1) if p else -1)\n",
                "df[\"metadata_matched\"] = df[\"meta_row\"] >= 0\n",
                "\n",
                "\n",
                "def meta_value(meta_row, key):\n",
                "    col = COL.get(key)\n",
                "    if meta_row < 0 or not col:\n",
                "        return \"\"\n",
                "    val = md.at[meta_row, col]\n",
                "    return \"\" if pd.isna(val) else str(val).strip()\n",
                "\n",
                "\n",
                "for field in (\"initials\", \"dob\", \"sex\", \"race\", \"ethnicity\", \"status\", \"dx1\", \"dx2\", \"note\"):\n",
                "    df[f\"meta_{field}\"] = df[\"meta_row\"].map(lambda i, f=field: meta_value(i, f))\n",
                "\n",
                "df = df.rename(columns={\n",
                "    \"meta_sex\": \"sex\", \"meta_race\": \"race\", \"meta_ethnicity\": \"ethnicity\",\n",
                "    \"meta_status\": \"study_status\", \"meta_dx1\": \"diagnosis1\",\n",
                "    \"meta_dx2\": \"diagnosis2\", \"meta_note\": \"metadata_note\",\n",
                "})\n",
                "\n",
                "# --- age at sample date -----------------------------------------------------\n",
                "# Birth date is used here and then discarded, so it never reaches an output.\n",
                "with warnings.catch_warnings():\n",
                "    warnings.simplefilter(\"ignore\")\n",
                "    dob = pd.to_datetime(df[\"meta_dob\"], errors=\"coerce\")\n",
                "\n",
                "df[\"age_at_sample_yrs\"] = ((df[\"sample_date\"] - dob).dt.days / 365.25).round(1)\n",
                "df.loc[(df[\"age_at_sample_yrs\"] < 0) | (df[\"age_at_sample_yrs\"] > 120),\n",
                "       \"age_at_sample_yrs\"] = np.nan\n",
                "\n",
                "# why age is blank, so a gap is explainable rather than mysterious\n",
                "df[\"age_unavailable_reason\"] = \"\"\n",
                "df.loc[df[\"age_at_sample_yrs\"].isna() & dob.isna() & df[\"metadata_matched\"],\n",
                "       \"age_unavailable_reason\"] = \"no birth date in metadata\"\n",
                "df.loc[df[\"age_at_sample_yrs\"].isna() & df[\"sample_date\"].isna(),\n",
                "       \"age_unavailable_reason\"] = \"no collection date (only a run date)\"\n",
                "df.loc[df[\"age_at_sample_yrs\"].isna() & ~df[\"metadata_matched\"],\n",
                "       \"age_unavailable_reason\"] = \"patient not matched to metadata\"\n",
                "\n",
                "n_no_dob = int((df[\"age_unavailable_reason\"] == \"no birth date in metadata\").sum())\n",
                "n_no_date = int((df[\"age_unavailable_reason\"] == \"no collection date (only a run date)\").sum())\n",
                "print(f\"\\nage computed for {df['age_at_sample_yrs'].notna().sum()}/{len(df)} files\"\n",
                "      f\"  (no DOB: {n_no_dob}, no collection date: {n_no_date})\")\n",
                "print(\"collection-date source:\")\n",
                "print(df[\"sample_date_source\"].value_counts().to_string())\n",
                "print(\"run-date source:\")\n",
                "print(df[\"run_date_source\"].value_counts().to_string())\n",
                "\n",
                "if DROP_BIRTH_DATE:\n",
                "    df = df.drop(columns=[\"meta_dob\"])\n",
                "    print(\"birth date dropped from the table - only age_at_sample_yrs remains\")\n",
                "\n",
                "# initials disagreement is worth flagging even when the ID matched\n",
                "mismatch = (df[\"metadata_matched\"] & (df[\"sample_initials\"] != \"\")\n",
                "            & (df[\"meta_initials\"].str.upper() != \"\")\n",
                "            & (df[\"sample_initials\"] != df[\"meta_initials\"].str.upper()))\n",
                "df.loc[mismatch, \"needs_review\"] = True\n",
                "df.loc[mismatch, \"review_reason\"] = df.loc[mismatch].apply(\n",
                "    lambda r: (r[\"review_reason\"] + \"; \" if r[\"review_reason\"] else \"\")\n",
                "              + f\"initials {r['sample_initials']} != metadata {r['meta_initials']}\", axis=1)\n",
                "\n",
                "print(f\"\\npatient ID resolved: {(df['patient_id'] != '').sum()}/{len(df)}\")\n",
                "print(f\"matched to metadata: {df['metadata_matched'].sum()}\")\n",
                "print(f\"flagged for review:  {df['needs_review'].sum()}\")\n",
                "\n",
                "\n",
                "# === CELL 8 : record type and QC verdict ====================================\n",
                "\n",
                "def record_type(r):\n",
                "    if r[\"is_placeholder\"]:\n",
                "        return \"placeholder_or_test\"\n",
                "    if r[\"is_standard\"]:\n",
                "        return \"standard\"\n",
                "    if r[\"metadata_matched\"]:\n",
                "        return \"patient_sample\"\n",
                "    if r[\"patient_id\"]:\n",
                "        return \"patient_id_not_in_metadata\"\n",
                "    if r[\"is_covid\"]:\n",
                "        return \"covid_project\"\n",
                "    if r[\"is_other_cohort\"]:\n",
                "        return \"other_cohort\"\n",
                "    if r[\"is_control\"]:\n",
                "        return \"healthy_control\"\n",
                "    if r[\"is_stimulation\"]:\n",
                "        return \"in_vitro_experiment\"\n",
                "    if r[\"specimen_type\"] != DEFAULT_SPECIMEN:\n",
                "        return \"non_blood_unidentified\"\n",
                "    return \"unclassified\"\n",
                "\n",
                "\n",
                "df[\"record_type\"] = df.apply(record_type, axis=1)\n",
                "df[\"is_non_blood\"] = df[\"specimen_type\"] != DEFAULT_SPECIMEN\n",
                "\n",
                "\n",
                "def qc_verdict(r):\n",
                "    problems = []\n",
                "    if pd.notna(r[\"binding_density\"]) and not (BD_MIN <= r[\"binding_density\"] <= BD_MAX):\n",
                "        problems.append(f\"binding_density={r['binding_density']:.2f}\")\n",
                "    if pd.notna(r[\"fov_ratio\"]) and r[\"fov_ratio\"] < FOV_MIN:\n",
                "        problems.append(f\"fov_ratio={r['fov_ratio']:.2f}\")\n",
                "    if r[\"n_probes\"] == 0:\n",
                "        problems.append(\"no_counts_in_file\")\n",
                "    if pd.notna(r[\"hk_geomean\"]) and r[\"hk_geomean\"] < 50:\n",
                "        problems.append(f\"low_housekeeping={r['hk_geomean']:.0f}\")\n",
                "    return \"; \".join(problems)\n",
                "\n",
                "\n",
                "df[\"qc_problems\"] = df.apply(qc_verdict, axis=1)\n",
                "df[\"qc_pass\"] = df[\"qc_problems\"] == \"\"\n",
                "\n",
                "print(df[\"record_type\"].value_counts())\n",
                "print()\n",
                "print(\"specimen types:\")\n",
                "print(df[\"specimen_type\"].value_counts())\n",
                "print(f\"\\nQC pass: {df['qc_pass'].sum()}/{len(df)}\")\n",
                "\n",
                "\n",
                "# === CELL 9 : readable filenames ============================================\n",
                "\n",
                "# visit number per patient, ordered by sample date\n",
                "# Collection date where we have it, run date only as a last resort for\n",
                "# ordering. filename_date_is records which one ended up in the new name.\n",
                "df[\"_sort_date\"] = df[\"sample_date\"].fillna(df[\"run_date\"])\n",
                "df[\"filename_date_is\"] = np.where(df[\"sample_date\"].notna(), \"collection\",\n",
                "                          np.where(df[\"run_date\"].notna(), \"run_date\", \"none\"))\n",
                "df[\"visit_num\"] = (\n",
                "    df[df[\"patient_id\"] != \"\"]\n",
                "    .sort_values([\"patient_id\", \"_sort_date\", \"raw_filename\"])\n",
                "    .groupby(\"patient_id\")\n",
                "    .cumcount() + 1\n",
                ").reindex(df.index)\n",
                "\n",
                "\n",
                "def build_new_name(r):\n",
                "    pid = r[\"patient_id\"] or \"NOID\"\n",
                "    parts = [pid]\n",
                "    if INCLUDE_INITIALS and r[\"sample_initials\"]:\n",
                "        parts.append(r[\"sample_initials\"])\n",
                "\n",
                "    d = r[\"_sort_date\"]\n",
                "    parts.append(d.strftime(\"%Y%m%d\") if pd.notna(d) else \"NODATE\")\n",
                "\n",
                "    if INCLUDE_DX:\n",
                "        parts.append(slug(r[\"diagnosis1\"]) or \"NODX\")\n",
                "    if INCLUDE_SPECIMEN and r[\"specimen_type\"] != DEFAULT_SPECIMEN:\n",
                "        parts.append(slug(r[\"specimen_type\"]))\n",
                "    if INCLUDE_VISIT and pd.notna(r[\"visit_num\"]):\n",
                "        parts.append(f\"v{int(r['visit_num']):02d}\")\n",
                "    if r[\"record_type\"] != \"patient_sample\":\n",
                "        parts.append(slug(r[\"record_type\"]))\n",
                "    if INCLUDE_LANE and r[\"lane_id\"]:\n",
                "        parts.append(f\"L{str(r['lane_id']).zfill(2)}\")\n",
                "    return \"_\".join(p for p in parts if p)\n",
                "\n",
                "\n",
                "df[\"new_filename\"] = df.apply(build_new_name, axis=1) + \".RCC\"\n",
                "\n",
                "# deterministic collision suffix\n",
                "dupe = df[\"new_filename\"].duplicated(keep=False)\n",
                "if dupe.any():\n",
                "    order = df[dupe].sort_values(\"raw_filename\").groupby(\"new_filename\").cumcount() + 1\n",
                "    df.loc[order.index, \"new_filename\"] = (\n",
                "        df.loc[order.index, \"new_filename\"].str.replace(r\"\\.RCC$\", \"\", regex=True)\n",
                "        + \"_d\" + order.astype(str) + \".RCC\")\n",
                "    print(f\"{dupe.sum()} filename collisions resolved with _dN suffixes\")\n",
                "\n",
                "rename_map = df[[\"raw_filename\", \"new_filename\", \"patient_id\", \"diagnosis1\",\n",
                "                 \"specimen_type\", \"record_type\", \"needs_review\"]].copy()\n",
                "print(f\"\\nexample new names:\")\n",
                "for _, r in rename_map.head(8).iterrows():\n",
                "    print(f\"  {r['raw_filename'][:45]:45s} -> {r['new_filename']}\")\n",
                "\n",
                "\n",
                "# === CELL 10 : optionally copy the files ====================================\n",
                "if RENAME_MODE in (\"copy_flat\", \"copy_tree\"):\n",
                "    dest_root = os.path.join(OUT, \"renamed\")\n",
                "    os.makedirs(dest_root, exist_ok=True)\n",
                "    copied = 0\n",
                "    for _, r in df.iterrows():\n",
                "        if RENAME_MODE == \"copy_tree\":\n",
                "            sub = os.path.join(dest_root,\n",
                "                               slug(r[\"diagnosis1\"]) or \"NODX\",\n",
                "                               r[\"patient_id\"] or \"NOID\")\n",
                "        else:\n",
                "            sub = dest_root\n",
                "        os.makedirs(sub, exist_ok=True)\n",
                "        shutil.copy2(os.path.join(FOLDER, r[\"raw_filename\"]),\n",
                "                     os.path.join(sub, r[\"new_filename\"]))\n",
                "        copied += 1\n",
                "    print(f\"copied {copied} files into {dest_root}\")\n",
                "else:\n",
                "    print(\"RENAME_MODE='map_only' - no files were copied. \"\n",
                "          \"Review nanostring_rename_map.csv, then set RENAME_MODE and re-run this cell.\")\n",
                "\n",
                "\n",
                "# === CELL 11 : wide count matrices ==========================================\n",
                "counts_long = counts_long.merge(\n",
                "    df[[\"raw_filename\", \"patient_id\", \"new_filename\", \"record_type\", \"specimen_type\"]],\n",
                "    on=\"raw_filename\", how=\"left\")\n",
                "\n",
                "panel_genes = [g for g in TARGET_GENES + HOUSEKEEPING\n",
                "               if g in set(counts_long[\"gene\"].astype(str))]\n",
                "absent = [g for g in TARGET_GENES + HOUSEKEEPING if g not in panel_genes]\n",
                "if absent:\n",
                "    print(f\"warning: {len(absent)} target genes never appear in any file: {absent}\")\n",
                "\n",
                "wide_target = (counts_long[counts_long[\"gene\"].astype(str).isin(panel_genes)]\n",
                "               .pivot_table(index=\"raw_filename\", columns=\"gene\", values=\"count\",\n",
                "                            aggfunc=\"first\", observed=True)\n",
                "               .reindex(columns=panel_genes))\n",
                "wide_target.columns = [str(c) for c in wide_target.columns]\n",
                "wide_target = wide_target.reset_index()\n",
                "print(f\"\\ntarget-gene matrix: {wide_target.shape[0]} samples x {len(panel_genes)} genes\")\n",
                "\n",
                "# full wide matrix, all probes, only if it will not explode\n",
                "n_probes_total = counts_long[\"gene\"].nunique()\n",
                "wide_all = None\n",
                "if n_probes_total <= 5000:\n",
                "    wide_all = (counts_long.pivot_table(index=\"raw_filename\", columns=\"gene\",\n",
                "                                        values=\"count\", aggfunc=\"first\", observed=True)\n",
                "                .reset_index())\n",
                "    wide_all.columns = [str(c) for c in wide_all.columns]\n",
                "    print(f\"full matrix: {wide_all.shape[0]} x {n_probes_total} probes\")\n",
                "else:\n",
                "    print(f\"{n_probes_total} distinct probes - skipping the full wide matrix, \"\n",
                "          \"use the long file instead\")\n",
                "\n",
                "\n",
                "# === CELL 12 : assemble the single master table =============================\n",
                "# One row per RCC file. Everything that used to be a separate sheet is now a\n",
                "# column you can filter on: record_type, specimen_type, needs_review, qc_pass.\n",
                "IDENTITY_COLS = [\n",
                "    # who\n",
                "    \"new_filename\", \"patient_id\", \"meta_initials\", \"sample_initials\",\n",
                "    # when / how old. sample_date is COLLECTION date; run_date is when the\n",
                "    # cartridge was run. They can be years apart.\n",
                "    \"sample_date\", \"sample_date_source\", \"age_at_sample_yrs\",\n",
                "    \"age_unavailable_reason\", \"visit_num\", \"filename_date_is\",\n",
                "    # demographics, straight from MetadataPatients_NoPHI (no birth date)\n",
                "    \"sex\", \"race\", \"ethnicity\", \"diagnosis1\", \"diagnosis2\", \"study_status\",\n",
                "    # what kind of sample\n",
                "    \"specimen_type\", \"is_non_blood\", \"record_type\",\n",
                "    \"has_timepoint\", \"is_stimulation\",\n",
                "    # how confident we are about the identity\n",
                "    \"needs_review\", \"review_reason\", \"id_source\", \"metadata_matched\",\n",
                "    # run / batch\n",
                "    \"run_date\", \"run_date_source\", \"cartridge\", \"lane_id\", \"operator\", \"position\",\n",
                "    \"gene_rlf\", \"n_probes\",\n",
                "    # QC\n",
                "    \"binding_density\", \"fov_ratio\", \"pos_control_geomean\", \"neg_control_mean\",\n",
                "    \"limit_of_detection\", \"hk_geomean\", \"n_housekeeping\", \"n_genes_above_lod\",\n",
                "    \"total_counts\", \"qc_pass\", \"qc_problems\",\n",
                "    # provenance\n",
                "    \"id_field_raw\", \"sample_comment\", \"metadata_note\", \"raw_filename\",\n",
                "]\n",
                "if DROP_INITIALS:\n",
                "    IDENTITY_COLS = [c for c in IDENTITY_COLS\n",
                "                     if c not in (\"meta_initials\", \"sample_initials\")]\n",
                "IDENTITY_COLS = [c for c in IDENTITY_COLS if c in df.columns]\n",
                "\n",
                "_counts_block = wide_target\n",
                "if INCLUDE_ALL_PROBES and wide_all is not None:\n",
                "    _counts_block = wide_all\n",
                "    _clash = [c for c in _counts_block.columns\n",
                "              if c != \"raw_filename\" and c in IDENTITY_COLS]\n",
                "    if _clash:                                   # never overwrite an annotation\n",
                "        _counts_block = _counts_block.rename(columns={c: f\"{c}_count\" for c in _clash})\n",
                "    # panel genes first (same order as before), then every other probe\n",
                "    _first = [g for g in panel_genes if g in _counts_block.columns]\n",
                "    _rest = [c for c in _counts_block.columns\n",
                "             if c not in _first and c != \"raw_filename\"]\n",
                "    _counts_block = _counts_block[[\"raw_filename\"] + _first + _rest]\n",
                "COUNT_COLS = [c for c in _counts_block.columns if c != \"raw_filename\"]\n",
                "final = df[IDENTITY_COLS].merge(_counts_block, on=\"raw_filename\", how=\"left\")\n",
                "\n",
                "# put raw_filename last\n",
                "final = final[[c for c in final.columns if c != \"raw_filename\"] + [\"raw_filename\"]]\n",
                "for c in (\"sample_date\", \"run_date\"):\n",
                "    if c in final.columns:\n",
                "        final[c] = final[c].dt.strftime(\"%Y-%m-%d\").fillna(\"\")\n",
                "\n",
                "# hard guarantee: no birth date in the output, whatever happened upstream\n",
                "if DROP_BIRTH_DATE:\n",
                "    leaked = [c for c in final.columns\n",
                "              if re.search(r\"birth|\\bdob\\b\", str(c), re.I)]\n",
                "    if leaked:\n",
                "        final = final.drop(columns=leaked)\n",
                "        print(f\"removed birth-date columns from output: {leaked}\")\n",
                "\n",
                "assert final[\"raw_filename\"].is_unique, \"duplicate rows per file - investigate\"\n",
                "print(f\"master table: {final.shape[0]} rows x {final.shape[1]} columns\")\n",
                "\n",
                "\n",
                "# === CELL 13 : write everything (CSV only) ==================================\n",
                "# One master CSV, every file and every column. The old sheet splits are\n",
                "# columns now, so filter in pandas (or Excel after opening):\n",
                "#   record_type == \"patient_sample\"  -> the analysis set\n",
                "#   record_type == \"standard\"        -> the standards\n",
                "#   needs_review == True             -> the identity conflicts to resolve\n",
                "#   is_non_blood == True             -> BAL, PBMC, sorted cells, tissue\n",
                "summary = pd.DataFrame({\n",
                "    \"metric\": [\n",
                "        \"RCC files found\", \"parsed successfully\", \"parse failures\",\n",
                "        \"patient ID resolved\", \"matched to metadata\", \"flagged needs_review\",\n",
                "        \"non-blood specimens\", \"standards\", \"QC pass\",\n",
                "        \"age computed\", \"no birth date in metadata\", \"no usable date on file\",\n",
                "        \"unique patients\", \"unique diagnoses\", \"distinct probes\",\n",
                "        \"date range\",\n",
                "    ],\n",
                "    \"value\": [\n",
                "        len(files), len(df), len(errors_df),\n",
                "        int((df[\"patient_id\"] != \"\").sum()), int(df[\"metadata_matched\"].sum()),\n",
                "        int(df[\"needs_review\"].sum()), int(df[\"is_non_blood\"].sum()),\n",
                "        int((df[\"record_type\"] == \"standard\").sum()), int(df[\"qc_pass\"].sum()),\n",
                "        int(df[\"age_at_sample_yrs\"].notna().sum()), n_no_dob, n_no_date,\n",
                "        df.loc[df[\"patient_id\"] != \"\", \"patient_id\"].nunique(),\n",
                "        df.loc[df[\"diagnosis1\"] != \"\", \"diagnosis1\"].nunique(),\n",
                "        n_probes_total,\n",
                "        f\"{df['_sort_date'].min():%Y-%m-%d} to {df['_sort_date'].max():%Y-%m-%d}\",\n",
                "    ],\n",
                "})\n",
                "\n",
                "# --- a column dictionary ----------------------------------------------------\n",
                "COMPARISON_NAMES = {\n",
                "    \"patient_id\": \"Pt ID / NIH Enroll ID\", \"meta_initials\": \"Pt Initials\",\n",
                "    \"sample_initials\": \"nanostring initials\", \"sample_date\": \"nanostring date\",\n",
                "    \"age_at_sample_yrs\": \"age (yrs)\", \"sex\": \"gender\", \"race\": \"race1\",\n",
                "    \"cartridge\": \"cartridge sample #\", \"raw_filename\": \"Process ID\",\n",
                "}\n",
                "dictionary = pd.DataFrame({\n",
                "    \"column\": list(final.columns),\n",
                "    \"kind\": [\"raw count\" if c in set(COUNT_COLS) else \"annotation\"\n",
                "             for c in final.columns],\n",
                "    \"matches_comparison_column\": [COMPARISON_NAMES.get(c, \"\") for c in final.columns],\n",
                "    \"non_empty_rows\": [int(final[c].notna().sum()) for c in final.columns],\n",
                "})\n",
                "\n",
                "# --- flat files -------------------------------------------------------------\n",
                "final.to_csv(os.path.join(OUT, \"nanostring_master.csv\"), index=False)\n",
                "summary.to_csv(os.path.join(OUT, \"nanostring_summary.csv\"), index=False)\n",
                "dictionary.to_csv(os.path.join(OUT, \"nanostring_column_dictionary.csv\"), index=False)\n",
                "rename_map.to_csv(os.path.join(OUT, \"nanostring_rename_map.csv\"), index=False)\n",
                "if not errors_df.empty:\n",
                "    errors_df.to_csv(os.path.join(OUT, \"nanostring_parse_errors.csv\"), index=False)\n",
                "if wide_all is not None:\n",
                "    wide_all.to_csv(os.path.join(OUT, \"nanostring_counts_wide_all_probes.csv\"), index=False)\n",
                "\n",
                "long_path = os.path.join(OUT, \"nanostring_counts_long.parquet\")\n",
                "try:\n",
                "    counts_long.to_parquet(long_path, index=False)\n",
                "except Exception:                                             # noqa: BLE001\n",
                "    long_path = os.path.join(OUT, \"nanostring_counts_long.csv.gz\")\n",
                "    counts_long.to_csv(long_path, index=False, compression=\"gzip\")\n",
                "\n",
                "print(\"\\n\" + summary.to_string(index=False))\n",
                "print(f\"\\nwritten to {OUT}:\")\n",
                "for f in sorted(os.listdir(OUT)):\n",
                "    p = os.path.join(OUT, f)\n",
                "    if os.path.isfile(p):\n",
                "        print(f\"  {f:46s} {os.path.getsize(p)/1e6:8.1f} MB\")\n",
                "\n",
                "print(\"\\nfilter nanostring_master.csv on these to get the old sub-tables:\")\n",
                "for col in (\"record_type\", \"specimen_type\"):\n",
                "    print(f\"\\n  {col}\")\n",
                "    for k, v in final[col].value_counts().items():\n",
                "        print(f\"    {k:30s} {v:>7,}\")\n",
                "print(f\"\\n  needs_review = True            {int(final['needs_review'].sum()):>7,}\")\n",
                "print(f\"  is_non_blood = True            {int(final['is_non_blood'].sum()):>7,}\")\n",
                "print(f\"  qc_pass = False                {int((~final['qc_pass']).sum()):>7,}\")\n",
                "\n",
                "\n",
                "# === CELL 13b : one row per PATIENT - metadata + age, no birth dates ========\n",
                "# nanostring_master.csv is one row per RCC *file*. This is the other view:\n",
                "# one row per person in the metadata sheet (including people with no RCC file\n",
                "# yet), with diagnosis, demographics, age and a summary of their samples.\n",
                "# Birth date is used only to compute age and is not written anywhere.\n",
                "_dob_col = COL[\"dob\"]\n",
                "pt = md.copy()\n",
                "_dob = (pd.to_datetime(pt[_dob_col], errors=\"coerce\") if _dob_col\n",
                "        else pd.Series(pd.NaT, index=pt.index))\n",
                "_now = pd.Timestamp.today().normalize()\n",
                "pt[\"age_now_yrs\"] = ((_now - _dob).dt.days / 365.25).round(1)\n",
                "pt.loc[(pt[\"age_now_yrs\"] < 0) | (pt[\"age_now_yrs\"] > 120), \"age_now_yrs\"] = np.nan\n",
                "\n",
                "_g = df[df[\"meta_row\"] >= 0].groupby(\"meta_row\")\n",
                "_stats = pd.DataFrame({\n",
                "    \"n_rcc_files\":      _g.size(),\n",
                "    \"n_whole_blood\":    _g[\"specimen_type\"].apply(lambda s: int((s == \"whole_blood\").sum())),\n",
                "    \"first_sample_date\": _g[\"sample_date\"].min(),\n",
                "    \"last_sample_date\":  _g[\"sample_date\"].max(),\n",
                "    \"first_run_date\":    _g[\"run_date\"].min(),\n",
                "    \"last_run_date\":     _g[\"run_date\"].max(),\n",
                "    \"age_at_first_sample_yrs\": _g[\"age_at_sample_yrs\"].min(),\n",
                "    \"age_at_last_sample_yrs\":  _g[\"age_at_sample_yrs\"].max(),\n",
                "})\n",
                "pt = pt.join(_stats)\n",
                "pt[\"n_rcc_files\"] = pt[\"n_rcc_files\"].fillna(0).astype(int)\n",
                "pt[\"n_whole_blood\"] = pt[\"n_whole_blood\"].fillna(0).astype(int)\n",
                "\n",
                "_key = pt[COL[\"enroll\"]].map(normalize_id) if COL[\"enroll\"] else pd.Series(\"\", index=pt.index)\n",
                "pt[\"duplicate_enrollment_id\"] = (_key != \"\") & _key.duplicated(keep=False)\n",
                "\n",
                "for c in (\"first_sample_date\", \"last_sample_date\", \"first_run_date\", \"last_run_date\"):\n",
                "    pt[c] = pt[c].dt.strftime(\"%Y-%m-%d\").fillna(\"\")\n",
                "\n",
                "# no birth dates in the output, whatever the source column is called\n",
                "pt = pt.drop(columns=[c for c in pt.columns\n",
                "                      if re.search(r\"birth|\\bdob\\b\", str(c), re.I)])\n",
                "if DROP_INITIALS and COL[\"initials\"] in pt.columns:\n",
                "    pt = pt.drop(columns=[COL[\"initials\"]])\n",
                "\n",
                "if COL[\"enroll\"]:\n",
                "    pt = pt.sort_values(COL[\"enroll\"], key=lambda s: s.astype(str).str.upper())\n",
                "\n",
                "pt_csv = os.path.join(OUT, \"nanostring_patients.csv\")\n",
                "pt.to_csv(pt_csv, index=False)\n",
                "\n",
                "print(f\"\\npatients table: {len(pt)} people, \"\n",
                "      f\"{int((pt['n_rcc_files'] > 0).sum())} with >=1 RCC file, \"\n",
                "      f\"{int(pt['age_now_yrs'].notna().sum())} with an age\")\n",
                "print(f\"  -> {pt_csv}\")\n",
                "print(\"  columns:\", list(pt.columns))\n",
                "\n",
                "\n",
                "# === CELL 14 : what are the standards actually good for? ====================\n",
                "# A standard / calibration tube is the SAME pooled RNA run again and again on\n",
                "# different cartridges. Biologically it never changes, so any difference in\n",
                "# its counts between cartridges is pure batch effect - which is exactly what\n",
                "# lets you correct for batch.\n",
                "#\n",
                "# Three different corrections get confused with each other. They stack:\n",
                "#   1. POS_A..POS_F spike-ins  -> hybridisation efficiency, within one lane\n",
                "#   2. housekeeping geomean    -> how much RNA went in, within one sample\n",
                "#   3. the standard tube       -> drift between cartridges and over years\n",
                "# Only #3 needs these files. #1 and #2 are already computed per sample above.\n",
                "#\n",
                "# Before calibrating anything you need to know two things about your\n",
                "# standards, and neither can be assumed. This cell answers both.\n",
                "\n",
                "std = df[df[\"record_type\"] == \"standard\"].copy()\n",
                "n_cart = df[\"cartridge\"].replace(\"\", np.nan).nunique()\n",
                "cart_with_std = std[\"cartridge\"].replace(\"\", np.nan).nunique()\n",
                "\n",
                "print(\"=\" * 70)\n",
                "print(\"STANDARDS DIAGNOSTIC\")\n",
                "print(\"=\" * 70)\n",
                "print(f\"standard files            : {len(std)}\")\n",
                "print(f\"distinct cartridges, all  : {n_cart}\")\n",
                "print(f\"cartridges with a standard: {cart_with_std}\"\n",
                "      f\"  ({cart_with_std / n_cart * 100:.1f}%)\" if n_cart else \"\")\n",
                "\n",
                "# --- Q1: can you calibrate per cartridge at all? ----------------------------\n",
                "if n_cart and cart_with_std / n_cart < 0.5:\n",
                "    print(\"\\n>> Most cartridges have NO standard on them. Per-cartridge\")\n",
                "    print(\"   calibration is not possible for the bulk of the data. Options,\")\n",
                "    print(\"   in order of how defensible they are:\")\n",
                "    print(\"     a) calibrate only the subset of cartridges that do have one\")\n",
                "    print(\"     b) treat run_date as the batch variable and model it\")\n",
                "    print(\"     c) look for unlabelled standards (candidates listed below)\")\n",
                "else:\n",
                "    print(\"\\n>> Enough coverage to calibrate per cartridge.\")\n",
                "\n",
                "# --- Q2: is it the same reference material throughout? ----------------------\n",
                "# Reference RNA lots get used up and replaced. A new lot is a step change in\n",
                "# the standard's counts, and calibrating across one would inject a fake\n",
                "# batch effect rather than remove it.\n",
                "std_counts = counts_long[\n",
                "    counts_long[\"raw_filename\"].isin(std[\"raw_filename\"])\n",
                "    & counts_long[\"code_class\"].astype(str).str.lower().str.startswith((\"endo\", \"house\"))\n",
                "].copy()\n",
                "\n",
                "std_profile = pd.DataFrame()\n",
                "if not std_counts.empty:\n",
                "    g = (std_counts.groupby(\"raw_filename\", observed=True)[\"count\"]\n",
                "         .apply(lambda s: _geomean(s.tolist())).rename(\"geomean_all_genes\"))\n",
                "    std_profile = (std[[\"raw_filename\", \"cartridge\", \"run_date\", \"id_field_raw\",\n",
                "                        \"hk_geomean\", \"pos_control_geomean\", \"qc_pass\"]]\n",
                "                   .merge(g, on=\"raw_filename\", how=\"left\")\n",
                "                   .sort_values(\"run_date\"))\n",
                "    std_profile[\"year\"] = std_profile[\"run_date\"].dt.year\n",
                "\n",
                "    print(\"\\nstandard signal by year (geomean across all genes):\")\n",
                "    yr = (std_profile.groupby(\"year\")[\"geomean_all_genes\"]\n",
                "          .agg(n=\"size\", median=\"median\",\n",
                "               cv=lambda s: s.std() / s.mean() if len(s) > 1 and s.mean() else np.nan))\n",
                "    print(yr.to_string(float_format=lambda v: f\"{v:,.2f}\"))\n",
                "\n",
                "    overall_cv = (std_profile[\"geomean_all_genes\"].std()\n",
                "                  / std_profile[\"geomean_all_genes\"].mean()\n",
                "                  if std_profile[\"geomean_all_genes\"].mean() else np.nan)\n",
                "    print(f\"\\noverall CV across all standards: {overall_cv:.1%}\")\n",
                "\n",
                "    # A new reference lot shows up as a step change, not as general noise, so\n",
                "    # look for the year boundary that best splits the series in two. Scored on\n",
                "    # the log scale with a t-like statistic, so a big ratio resting on two\n",
                "    # noisy points does not beat a smaller but cleanly separated step.\n",
                "    MIN_PER_SIDE = 3\n",
                "    steps = []\n",
                "    lvl = np.log(std_profile[\"geomean_all_genes\"].where(\n",
                "        std_profile[\"geomean_all_genes\"] > 0))\n",
                "    yrs = sorted(std_profile[\"year\"].dropna().unique())\n",
                "    for cut in yrs[1:]:\n",
                "        before = lvl[std_profile[\"year\"] < cut].dropna()\n",
                "        after = lvl[std_profile[\"year\"] >= cut].dropna()\n",
                "        if len(before) < MIN_PER_SIDE or len(after) < MIN_PER_SIDE:\n",
                "            continue\n",
                "        se = np.sqrt(before.var(ddof=1) / len(before) + after.var(ddof=1) / len(after))\n",
                "        diff = after.mean() - before.mean()\n",
                "        t = abs(diff) / se if se and np.isfinite(se) else np.nan\n",
                "        steps.append((int(cut), float(np.exp(diff)), float(t), len(before), len(after)))\n",
                "\n",
                "    if steps:\n",
                "        steps.sort(key=lambda s: -(s[2] if np.isfinite(s[2]) else 0))\n",
                "        cut, ratio, t, nb, na = steps[0]\n",
                "        print(f\"largest step change: {cut} ({nb} standards before, {na} after), \"\n",
                "              f\"level {ratio:.2f}x, separation t={t:.1f}\")\n",
                "        if t >= 3 and (ratio > 1.3 or ratio < 0.77):\n",
                "            print(\">> That is a step, not drift. Most likely a new reference lot\")\n",
                "            print(f\"   or a protocol change. Set ERA_BREAKS = ['{cut}-01-01'] in\")\n",
                "            print(\"   Cell 15 so factors are computed within each era separately.\")\n",
                "            print(\"   Calibrating across a step injects a fake batch effect.\")\n",
                "        else:\n",
                "            print(\">> No clean step. Consistent with one reference material.\")\n",
                "        print(\"\\n   all candidate split years (year, ratio, t):\")\n",
                "        for c, r, tt, _, _ in sorted(steps):\n",
                "            print(f\"     {c}  {r:5.2f}x  t={tt:4.1f}\")\n",
                "    elif pd.notna(overall_cv) and overall_cv > 0.5:\n",
                "        print(\">> High spread but too few standards to localise a step change.\")\n",
                "\n",
                "# --- Q3: are there standards you never labelled as such? --------------------\n",
                "# An ID string that shows up on many different cartridges is behaving like a\n",
                "# standard whether or not anyone called it one.\n",
                "rep = (df[df[\"id_field_raw\"].str.strip() != \"\"]\n",
                "       .groupby(\"id_field_raw\")\n",
                "       .agg(files=(\"raw_filename\", \"size\"),\n",
                "            cartridges=(\"cartridge\", pd.Series.nunique),\n",
                "            labelled_standard=(\"record_type\", lambda s: (s == \"standard\").any()),\n",
                "            span_days=(\"run_date\", lambda s: (s.max() - s.min()).days\n",
                "                       if s.notna().sum() > 1 else 0))\n",
                "       .reset_index())\n",
                "candidates = (rep[(rep[\"cartridges\"] >= 5) & (~rep[\"labelled_standard\"])]\n",
                "              .sort_values(\"cartridges\", ascending=False))\n",
                "print(f\"\\nunlabelled IDs appearing on 5+ cartridges: {len(candidates)}\")\n",
                "if not candidates.empty:\n",
                "    print(candidates.head(15).to_string(index=False))\n",
                "    print(\">> Check these. Any that are really the same pooled RNA should be\")\n",
                "    print(\"   added to STANDARD_PAT in Cell 2 and the pipeline re-run.\")\n",
                "\n",
                "std_profile.to_csv(os.path.join(OUT, \"standards_profile.csv\"), index=False)\n",
                "candidates.to_csv(os.path.join(OUT, \"standards_candidates_unlabelled.csv\"), index=False)\n",
                "\n",
                "\n",
                "# === CELL 15 : per-cartridge calibration factors ============================\n",
                "# For each cartridge that carries a standard, and each gene:\n",
                "#     factor = (reference level for that gene) / (this cartridge's standard)\n",
                "# Multiply a patient sample's counts by its cartridge's factor and the\n",
                "# cartridge-to-cartridge drift cancels out. The reference level is the median\n",
                "# across all standards in the same era, so factors centre on 1.\n",
                "#\n",
                "# Factors are written out but NOT applied. Look at them first - a factor far\n",
                "# from 1 means that cartridge was an outlier, and you want to know why before\n",
                "# you silently rescale patient data with it.\n",
                "APPLY_CALIBRATION = False\n",
                "ERA_BREAKS = []          # e.g. [\"2018-01-01\"] to split at a known lot change\n",
                "\n",
                "calib = pd.DataFrame()\n",
                "if not std_counts.empty and cart_with_std:\n",
                "    sc = std_counts.merge(df[[\"raw_filename\", \"cartridge\", \"run_date\"]],\n",
                "                          on=\"raw_filename\", how=\"left\")\n",
                "    sc = sc[sc[\"cartridge\"].astype(str).str.strip() != \"\"]\n",
                "    sc[\"gene\"] = sc[\"gene\"].astype(str)      # drop categorical, it breaks reindex\n",
                "\n",
                "    breaks = [pd.Timestamp.min] + [pd.Timestamp(b) for b in ERA_BREAKS] + [pd.Timestamp.max]\n",
                "    sc[\"era\"] = pd.cut(sc[\"run_date\"], bins=breaks, labels=False, include_lowest=True)\n",
                "\n",
                "    # one value per cartridge x gene (average if a cartridge ran 2 standards)\n",
                "    per_cart = (sc.groupby([\"era\", \"cartridge\", \"gene\"], observed=True)[\"count\"]\n",
                "                .mean().reset_index())\n",
                "    # reference = median across cartridges, within era and gene\n",
                "    ref = (per_cart.groupby([\"era\", \"gene\"], observed=True)[\"count\"]\n",
                "           .median().rename(\"reference\").reset_index())\n",
                "\n",
                "    calib = per_cart.merge(ref, on=[\"era\", \"gene\"], how=\"left\")\n",
                "    calib[\"factor\"] = np.where(calib[\"count\"] > 0,\n",
                "                               calib[\"reference\"] / calib[\"count\"], np.nan)\n",
                "    calib = calib.rename(columns={\"count\": \"standard_count\"})\n",
                "\n",
                "    spread = (calib.groupby(\"cartridge\")[\"factor\"]\n",
                "              .agg(median_factor=\"median\", min_factor=\"min\", max_factor=\"max\")\n",
                "              .sort_values(\"median_factor\"))\n",
                "    print(\"\\n\" + \"=\" * 70)\n",
                "    print(\"CALIBRATION FACTORS\")\n",
                "    print(\"=\" * 70)\n",
                "    print(f\"{calib['cartridge'].nunique()} cartridges x {calib['gene'].nunique()} genes\")\n",
                "    print(\"\\ncartridges furthest from the reference:\")\n",
                "    print(pd.concat([spread.head(5), spread.tail(5)])\n",
                "          .to_string(float_format=lambda v: f\"{v:,.2f}\"))\n",
                "\n",
                "    outliers = spread[(spread[\"median_factor\"] < 0.5) | (spread[\"median_factor\"] > 2.0)]\n",
                "    if len(outliers):\n",
                "        print(f\"\\n>> {len(outliers)} cartridges are off by more than 2x. Investigate\")\n",
                "        print(\"   these before applying anything - a failed standard lane will\")\n",
                "        print(\"   otherwise drag every patient sample on that cartridge with it.\")\n",
                "\n",
                "    calib.to_csv(os.path.join(OUT, \"calibration_factors.csv\"), index=False)\n",
                "\n",
                "    if APPLY_CALIBRATION:\n",
                "        cf = calib.set_index([\"cartridge\", \"gene\"])[\"factor\"]\n",
                "        cal_long = counts_long.merge(df[[\"raw_filename\", \"cartridge\"]],\n",
                "                                     on=\"raw_filename\", how=\"left\")\n",
                "        idx = pd.MultiIndex.from_arrays(\n",
                "            [cal_long[\"cartridge\"].astype(str), cal_long[\"gene\"].astype(str)])\n",
                "        cal_long[\"factor\"] = cf.reindex(idx).values\n",
                "        cal_long[\"count_calibrated\"] = cal_long[\"count\"] * cal_long[\"factor\"].fillna(1.0)\n",
                "        cal_long[\"was_calibrated\"] = cal_long[\"factor\"].notna()\n",
                "        cal_long.to_csv(os.path.join(OUT, \"counts_calibrated_long.csv.gz\"),\n",
                "                        index=False, compression=\"gzip\")\n",
                "        print(f\"\\napplied to {cal_long['was_calibrated'].sum():,} of \"\n",
                "              f\"{len(cal_long):,} measurements \"\n",
                "              f\"({cal_long['was_calibrated'].mean():.1%} had a factor available)\")\n",
                "    else:\n",
                "        print(\"\\nAPPLY_CALIBRATION is False - factors written, counts untouched.\")\n",
                "else:\n",
                "    print(\"\\nno usable standards with cartridge IDs, skipping calibration\")"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
